<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    ResultsView.fxml — embedded center pane.
    Two stacked surfaces: results table above, diff card below.
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ce316.iae.ui.ResultsViewController"
      spacing="14">

    <!-- ───── Summary row ───── -->
    <HBox alignment="CENTER_LEFT" spacing="14">
        <Label text="RESULTS" styleClass="label-overline"/>
        <Label fx:id="summaryLabel"
               text="No run yet"
               styleClass="body,text-muted"/>
    </HBox>

    <!-- ───── Results table (primary surface) ───── -->
    <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
        <placeholder>
            <VBox alignment="CENTER" spacing="8">
                <padding><Insets top="36" right="24" bottom="36" left="24"/></padding>
                <Label text="No results yet"
                       styleClass="display-md"/>
                <Label text="Use the Run grading button below to evaluate every submission against the project's test cases."
                       styleClass="body-sm,text-muted"
                       wrapText="true"
                       maxWidth="380"
                       style="-fx-text-alignment: center;"/>
            </VBox>
        </placeholder>

        <columns>
            <TableColumn fx:id="studentIdColumn" text="STUDENT"      prefWidth="200"/>
            <TableColumn fx:id="statusColumn"    text="STATUS"       prefWidth="160"/>
            <TableColumn fx:id="errorColumn"     text="ERROR / INFO" prefWidth="420"/>
        </columns>
    </TableView>

    <!-- ───── Diff card ───── -->
    <VBox spacing="8" styleClass="tile">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="DIFF" styleClass="label-overline"/>
            <Label text="expected vs. actual"
                   styleClass="body-sm,text-faint"/>
        </HBox>
        <TextArea fx:id="diffTextArea"
                  VBox.vgrow="SOMETIMES"
                  prefHeight="170"
                  minHeight="120"
                  editable="false"
                  wrapText="true"
                  promptText="Select a row above to inspect expected vs. actual output."
                  styleClass="mono"/>
    </VBox>

</VBox>
