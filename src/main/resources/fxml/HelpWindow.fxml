<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>
<?import javafx.geometry.Insets?>

<!--
    HelpWindow.fxml  —  User Manual window (WebView).
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ce316.iae.ui.HelpWindowController"
      prefWidth="940" prefHeight="680">

    <!-- ── Header bar ── -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="help-bar,help-bar-top">
        <padding><Insets top="14" right="22" bottom="14" left="22"/></padding>
        <Label text="MANUAL" styleClass="label-overline"/>
        <Label text="IAE — User Manual" styleClass="display-md"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- ── WebView fills remaining space ── -->
    <WebView fx:id="helpWebView" VBox.vgrow="ALWAYS"/>

    <!-- ── Footer ── -->
    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="help-bar,help-bar-bottom">
        <padding><Insets top="10" right="22" bottom="10" left="22"/></padding>
        <Button text="Close" onAction="#handleClose" styleClass="btn-ghost"/>
    </HBox>

</VBox>
