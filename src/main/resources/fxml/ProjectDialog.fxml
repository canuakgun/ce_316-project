<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    ProjectDialog.fxml — Create / Edit a project.
    Modal-surface treatment with header / body / footer zones.
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ce316.iae.ui.ProjectDialogController"
      styleClass="modal-surface"
      prefWidth="600">

    <!-- ─────────── HEADER ─────────── -->
    <VBox styleClass="modal-header" spacing="4">
        <Label text="PROJECT" styleClass="label-overline"/>
        <Label text="Configure assignment" styleClass="display-md"/>
        <Label text="A project pairs one language configuration with a folder of student submissions and the test cases used to grade them."
               styleClass="body-sm,text-muted"
               wrapText="true">
            <VBox.margin><Insets top="4"/></VBox.margin>
        </Label>
    </VBox>

    <!-- ─────────── BODY ─────────── -->
    <VBox styleClass="modal-body" spacing="16">

        <!-- Project name -->
        <VBox spacing="6">
            <Label text="PROJECT NAME" styleClass="label-overline"/>
            <TextField fx:id="nameField"
                       promptText="e.g. Sorting Assignment · Spring 2025"/>
        </VBox>

        <!-- Two-up row: configuration + submissions dir -->
        <VBox spacing="6">
            <Label text="LANGUAGE CONFIGURATION" styleClass="label-overline"/>
            <ComboBox fx:id="configComboBox" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6">
            <Label text="SUBMISSIONS DIRECTORY" styleClass="label-overline"/>
            <HBox spacing="8">
                <TextField fx:id="submissionsDirField"
                           promptText="Path to folder containing student ZIPs"
                           HBox.hgrow="ALWAYS"/>
                <Button text="Browse…"
                        onAction="#handleBrowseDirectory"
                        styleClass="btn-ghost"/>
            </HBox>
        </VBox>

        <!-- Test cases tile -->
        <VBox spacing="10" styleClass="tile">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="TEST CASES" styleClass="label-overline"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <GridPane hgap="8" vgap="6">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="78" maxWidth="78"/>
                </columnConstraints>
                <Label text="Input args"      styleClass="label-overline"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="Expected output" styleClass="label-overline"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <TextField fx:id="inputArgsField"
                           promptText="banana apple"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="expectedOutputField"
                           promptText="apple banana"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Button text="Add"
                        onAction="#handleAddTestCase"
                        styleClass="btn-primary"
                        maxWidth="Infinity"
                        GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            </GridPane>

            <ListView fx:id="testCaseListView" prefHeight="140">
                <placeholder>
                    <Label text="No test cases yet — add one above."
                           styleClass="body-sm,text-faint"/>
                </placeholder>
            </ListView>

            <HBox alignment="CENTER_RIGHT">
                <Button text="Remove selected"
                        onAction="#handleRemoveTestCase"
                        styleClass="btn-ghost,text-danger"/>
            </HBox>
        </VBox>

        <!-- Validation error -->
        <Label fx:id="errorLabel"
               text=""
               styleClass="field-error"
               visible="false"
               managed="false"
               wrapText="true"/>

    </VBox>

    <!-- ─────────── FOOTER ─────────── -->
    <HBox styleClass="modal-footer" spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel"
                onAction="#handleCancel"
                styleClass="btn-ghost"
                cancelButton="true"/>
        <Button text="Save project"
                onAction="#handleConfirm"
                styleClass="btn-primary"
                defaultButton="true"/>
    </HBox>

</VBox>
