<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    ConfigDialog.fxml — CRUD + import/export for Configuration objects.
    Controller: com.ce316.iae.ui.ConfigDialogController
-->
<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ce316.iae.ui.ConfigDialogController"
      spacing="16"
      prefWidth="680"
      prefHeight="400">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <!-- ── Left panel ── -->
    <VBox spacing="6" minWidth="180">

        <Label text="Saved Configurations" style="-fx-font-weight:bold;"/>

        <ListView fx:id="configListView"
                  VBox.vgrow="ALWAYS">

            <placeholder>
                <Label text="No configurations yet."/>
            </placeholder>

        </ListView>

        <HBox spacing="6">

            <Button text="New"
                    onAction="#handleNew"
                    maxWidth="Infinity"
                    HBox.hgrow="ALWAYS"/>

            <Button text="Delete"
                    onAction="#handleDelete"
                    maxWidth="Infinity"
                    HBox.hgrow="ALWAYS"
                    style="-fx-text-fill: red;"/>

        </HBox>
    </VBox>

    <Separator orientation="VERTICAL"/>

    <!-- ── Right panel ── -->
    <VBox spacing="10" HBox.hgrow="ALWAYS">

        <Label text="Configuration Details"
               style="-fx-font-weight:bold; -fx-font-size:13px;"/>

        <GridPane hgap="10" vgap="8">

            <columnConstraints>
                <ColumnConstraints minWidth="160" maxWidth="160"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="nameField"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0"
                       promptText="e.g. C Config"/>

            <Label text="Compiler / Interpreter:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="compilerPathField"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"
                       promptText="e.g. gcc or python3"/>

            <Label text="Compile Args:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="compileArgsField"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"
                       promptText="{SOURCE_FILE} -o {OUTPUT_PATH}"/>

            <Label text="File to Compile:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="fileToCompileField"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="3"
                       promptText="e.g. main.c"/>

            <Label text="Executable Path:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="executablePathField"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="4"
                       promptText="e.g. a.out or main"/>

            <Label text="Interpreted language:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <CheckBox fx:id="interpretedCheckBox"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="5"
                      text="(Python / scripting — no compilation step)"/>

        </GridPane>

        <!-- Status -->
        <Label fx:id="statusLabel"
               text=""
               style="-fx-text-fill: #555555;"
               wrapText="true"/>

        <!-- Push bottom -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Buttons -->
        <HBox spacing="8" alignment="CENTER_RIGHT">

            <Button text="Import…"
                    onAction="#handleImport"/>

            <Button text="Export…"
                    onAction="#handleExport"/>

            <Separator orientation="VERTICAL"/>

            <Button text="Save"
                    onAction="#handleSave"
                    defaultButton="true"
                    style="-fx-font-weight:bold;"/>

            <Button text="Close"
                    onAction="#handleClose"
                    cancelButton="true"/>

        </HBox>

    </VBox>

</HBox>