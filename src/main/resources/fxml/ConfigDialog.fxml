<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    ConfigDialog.fxml — CRUD + import/export for language configurations.
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ce316.iae.ui.ConfigDialogController"
      styleClass="modal-surface"
      prefWidth="780" prefHeight="500">

    <!-- ─────────── HEADER ─────────── -->
    <VBox styleClass="modal-header" spacing="4">
        <Label text="CONFIGURATIONS" styleClass="label-overline"/>
        <Label text="Language toolchains" styleClass="display-md"/>
        <Label text="Configurations describe how to compile and execute student code for a given language. They are shared across all projects."
               styleClass="body-sm,text-muted"
               wrapText="true">
            <VBox.margin><Insets top="4"/></VBox.margin>
        </Label>
    </VBox>

    <!-- ─────────── BODY: two-column split ─────────── -->
    <HBox spacing="20" styleClass="modal-body" VBox.vgrow="ALWAYS">

        <!-- LEFT: saved configurations list -->
        <VBox spacing="10" minWidth="210" prefWidth="230">
            <Label text="SAVED" styleClass="label-overline"/>

            <ListView fx:id="configListView" VBox.vgrow="ALWAYS">
                <placeholder>
                    <VBox alignment="CENTER" spacing="6">
                        <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>
                        <Label text="No configurations yet"
                               styleClass="body-sm,text-strong"/>
                        <Label text="Use New to create one."
                               styleClass="body-sm,text-faint"/>
                    </VBox>
                </placeholder>
            </ListView>

            <HBox spacing="6">
                <Button text="+ New"
                        onAction="#handleNew"
                        styleClass="btn-ghost"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"/>
                <Button text="Delete"
                        onAction="#handleDelete"
                        styleClass="btn-ghost,text-danger"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- RIGHT: detail form -->
        <VBox spacing="14" HBox.hgrow="ALWAYS">
            <Label text="DETAILS" styleClass="label-overline"/>

            <VBox spacing="6">
                <Label text="NAME" styleClass="label-overline"/>
                <TextField fx:id="nameField" promptText="e.g. C · gcc"/>
            </VBox>

            <VBox spacing="6">
                <Label text="COMPILER / INTERPRETER" styleClass="label-overline"/>
                <TextField fx:id="compilerPathField"
                           promptText="e.g. gcc, python3, ghc"/>
            </VBox>

            <VBox spacing="6">
                <Label text="COMPILE ARGUMENTS" styleClass="label-overline"/>
                <TextField fx:id="compileArgsField"
                           promptText="{SOURCE_FILE} -o {OUTPUT_PATH}"
                           styleClass="mono"/>
            </VBox>

            <HBox spacing="14">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="FILE TO COMPILE" styleClass="label-overline"/>
                    <TextField fx:id="fileToCompileField"
                               promptText="main.c"
                               styleClass="mono"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="EXECUTABLE PATH" styleClass="label-overline"/>
                    <TextField fx:id="executablePathField"
                               promptText="a.out"
                               styleClass="mono"/>
                </VBox>
            </HBox>

            <CheckBox fx:id="interpretedCheckBox"
                      text="Interpreted language (no compile step — Python, JS, etc.)"/>

            <Label fx:id="statusLabel"
                   text=""
                   styleClass="body-sm,text-muted"
                   wrapText="true"/>

            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

    <!-- ─────────── FOOTER ─────────── -->
    <HBox styleClass="modal-footer" spacing="10" alignment="CENTER_LEFT">
        <Button text="Import…"
                onAction="#handleImport"
                styleClass="btn-ghost"/>
        <Button text="Export…"
                onAction="#handleExport"
                styleClass="btn-ghost"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Close"
                onAction="#handleClose"
                styleClass="btn-ghost"
                cancelButton="true"/>
        <Button text="Save"
                onAction="#handleSave"
                styleClass="btn-primary"
                defaultButton="true"/>
    </HBox>

</VBox>
