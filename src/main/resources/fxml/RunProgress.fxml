<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    RunProgress.fxml — Modal progress dialog shown during a pipeline run.
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ce316.iae.ui.RunProgressController"
      styleClass="modal-surface"
      prefWidth="440">

    <VBox styleClass="modal-header" spacing="4">
        <Label text="RUNNING" styleClass="label-overline"/>
        <Label text="Grading in progress" styleClass="display-md"/>
    </VBox>

    <VBox styleClass="modal-body" spacing="14">
        <Label fx:id="statusLabel"
               text="Starting…"
               styleClass="body,text-muted"
               wrapText="true"/>

        <ProgressBar fx:id="progressBar"
                     maxWidth="Infinity"
                     prefHeight="6"/>
    </VBox>

    <HBox styleClass="modal-footer" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton"
                text="Cancel run"
                onAction="#handleCancel"
                styleClass="btn-ghost"
                cancelButton="true"/>
    </HBox>

</VBox>
